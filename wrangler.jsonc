{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vega-web",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "routes": [
    {"pattern": "web.vega-app.in", "zone_name": "vega-app.in", "custom_domain": true}
  ],
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application"
  }
}
